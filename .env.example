# This project's own .env - Zerodha/Kite credentials only. TradingAgents has
# no use for anything here; its own LLM provider keys and TRADINGAGENTS_*
# settings live in a separate file: vendor/TradingAgents/.env (copy that one
# from vendor/TradingAgents/.env.example - it's upstream's, kept current with
# whatever providers TradingAgents supports, so it's not duplicated here).
#
# Both files are loaded by explicit path in kite_trader/runner.py - see
# README.md's Setup section.

# ---------------------------------------------------------------- Zerodha ---
# From the Kite Connect developer console (https://developers.kite.trade).
KITE_API_KEY=
KITE_API_SECRET=

# Optional. Kite access tokens die at 6:00 AM IST every day and cannot be
# refreshed headlessly. Leave both blank for the normal interactive login;
# set one of them to run unattended with a token minted earlier today.
# KITE_ACCESS_TOKEN=
# KITE_REQUEST_TOKEN=
