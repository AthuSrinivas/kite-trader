# ---------------------------------------------------------------- Zerodha ---
# From the Kite Connect developer console (https://developers.kite.trade).
KITE_API_KEY=
KITE_API_SECRET=

# Optional. Kite access tokens die at 6:00 AM IST every day and cannot be
# refreshed headlessly. Leave both blank for the normal interactive login;
# set one of them to run unattended with a token minted earlier today.
# KITE_ACCESS_TOKEN=
# KITE_REQUEST_TOKEN=

# ---------------------------------------------------------- TradingAgents ---
# Read by upstream's DEFAULT_CONFIG; no code in this project touches them.
# Set the key for whichever provider you select below.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4-mini
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Market data used by the analysts.
ALPHA_VANTAGE_API_KEY=
